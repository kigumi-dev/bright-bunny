import os from std/os
import tui from github.com/kigumi-dev/bright-bunny
import sty from github.com/kigumi-dev/exp/style

type Model = {
    count Int
    ticks Int
}

type Msg =
    | Increment
    | Decrement
    | Reset
    | Tick
    | Pasted(text: String)
    | Leave

pure fn init() -> tui.Step[Model, Msg] {
    tui.still(Model {
        count: 0
        ticks: 0
    })
}

pure fn update(m: Model, msg: Msg) -> tui.Step[Model, Msg] {
    match msg {
        Increment -> tui.still(Model {
            count: m.count + 1
            ticks: m.ticks
        })
        Decrement -> tui.still(Model {
            count: m.count - 1
            ticks: m.ticks
        })
        Reset -> tui.still(Model {
            count: 0
            ticks: m.ticks
        })
        Pasted(t) -> tui.still(Model {
            count: (t.len().toInt() || 0)
            ticks: m.ticks
        })
        Tick -> tui.still(Model {
            count: m.count
            ticks: m.ticks + 1
        })
        Leave -> tui.Step {
            model: m
            cmd: tui.Cmd.Quit
        }
    }
}

/// The count is green while positive, red while negative, plain at zero.
pure fn countStyle(n: Int) -> sty.Style {
    let base = sty.plain().withBold(true)
    if n > 0 {
        return base.withFg(sty.green())
    }
    if n < 0 {
        return base.withFg(sty.red())
    }
    base
}

pure fn view(m: Model) -> tui.Viewed[Model, Msg] {
    let body: tui.Node[Msg] = tui.column(Array.of[tui.Node[Msg]](tui.Node.Text(""), tui.styled(tui.Node.Text("  count   ${m.count}"), countStyle(m.count)), tui.styled(tui.Node.Text("  ticks   ${m.ticks}"), sty.plain().withDim(true)), tui.Node.Text("  emoji   \u{1f468}\u{200d}\u{1f469}\u{200d}\u{1f467} \u{1f1ef}\u{1f1f5} \u{1f44d}\u{1f3fd}")))
    let title: tui.Node[Msg] = tui.styled(tui.Node.Text(" kigumi tui — counter "), sty.plain().withFg(sty.black()).withBg(sty.cyan()).withBold(true))
    let help: tui.Node[Msg] = tui.styled(tui.Node.Text(" +/- change   r reset   q quit "), sty.plain().withDim(true))
    let screen: tui.Node[Msg] = tui.column(Array.of[tui.Node[Msg]](tui.fixed(title, 1), tui.flex(tui.bordered(body, sty.rounded(), sty.plain().withFg(sty.blue())), 1), tui.fixed(help, 1)))
    let node: tui.Node[Msg] = screen
        |> tui.onKeyName("+", Msg.Increment)
        |> tui.onKeyName("-", Msg.Decrement)
        |> tui.onKeyName("r", Msg.Reset)
        |> tui.onKeyName("q", Msg.Leave)
        |> tui.onKeyName("ctrl+c", Msg.Leave)
        |> tui.onPaste((t: String) => Some(Msg.Pasted(t)))
    tui.Viewed {
        node: node
        model: m
    }
}

pure fn subs(m: Model) -> tui.Sourced[Model, Msg] {
    tui.Sourced {
        subs: tui.Sub.Every(1000, () => Msg.Tick)
        model: m
    }
}

fn main(host: os.Host) -> Void! {
    let _ = tui.run(host, tui.App {
        init: init
        update: update
        view: view
        subs: subs
    })?
}
